# ==========================================================================
# Gnani EMI Collections Voice Agent — environment configuration example.
#
# Copy this file to `.env` and adjust values for your environment. Every
# variable has a safe default baked into app/core/config.py, so the service
# boots with ZERO configuration (mock Gnani mode + local JSON storage).
# NEVER commit a real `.env` file — it is git-ignored.
# ==========================================================================

# --- General --------------------------------------------------------------
APP_NAME="Gnani EMI Collections Voice Agent"
APP_VERSION=1.0.0
# One of: development | staging | production | test
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Security ---------------------------------------------------------------
# API key required via the `X-API-Key` header on all business endpoints
# (/api/Initial_Message, /api/v1/calls*, /api/v1/stats). CHANGE IN PRODUCTION —
# the default below is intentionally insecure and logs a loud warning if used.
API_KEY=dev-api-key
# Separate key required via the `X-Webhook-Key` header on the post-call
# webhook endpoint only. CHANGE IN PRODUCTION.
WEBHOOK_API_KEY=dev-webhook-key

# --- Gnani Agents Console integration ---------------------------------------
# "mock" simulates the Gnani call-trigger API in-process (default, no network
# calls, deterministic failure injection for testing — see gnani_client.py).
# "live" performs real HTTP calls to GNANI_BASE_URL.
GNANI_MODE=mock
GNANI_BASE_URL=https://console.gnani.ai
# Required when GNANI_MODE=live. Never commit a real key.
GNANI_API_KEY=
GNANI_AGENT_ID=agent-emi-collections
GNANI_CALLER_ID=+10000000000
GNANI_ASR_MODEL=gnani-prisma
GNANI_TTS_MODEL=gnani-timbre-2.5
GNANI_LLM_MODEL=gnani-evon
# Per-request timeout (seconds) for the Gnani trigger call.
GNANI_TIMEOUT_SECONDS=10.0
# Max retry attempts (tenacity) on TimeoutException/ConnectError/5xx only.
GNANI_MAX_RETRIES=3
# Base backoff (seconds) for exponential retry between attempts.
GNANI_RETRY_BACKOFF_SECONDS=0.5

# --- Storage -----------------------------------------------------------------
# Leave MONGODB_URI empty to use the zero-config JSON file repository
# (atomic writes under JSON_STORE_PATH). Set it to switch to MongoDB (motor).
MONGODB_URI=
MONGODB_DB=gnani_emi
JSON_STORE_PATH=./data/calls.json

# Directory served at /recordings for call recording playback (.wav/.mp3 files
# named after call_id, e.g. CALL-20260728-0001.wav). Created automatically at
# startup if missing; the mount is skipped (with a warning) if it can't be created.
RECORDINGS_DIR=./samples/recordings

# --- Webhook / messaging ------------------------------------------------------
# Base URL this service is reachable at, passed to Gnani as the callback
# target for the post-call webhook when GNANI_MODE=live.
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8000
DEFAULT_CURRENCY=USD
ORG_NAME="Apex Financial Services"
BOT_NAME=Aria
# Comma-separated list of allowed CORS origins, or "*" for all.
CORS_ORIGINS=*

# --- Stage code engine tunables -----------------------------------------------
# Minimum confidence required before a proposed stage code is trusted;
# below this, the engine downgrades to UNCLEAR/DSCN/BUSY/RNR as appropriate.
STAGE_CODE_CONFIDENCE_THRESHOLD=0.6
